rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{f} {
      allow read: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['member', 'admin'];
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
