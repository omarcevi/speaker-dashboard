rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(roles) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().role in roles;
    }

    function isMember() {
      return hasRole(['member', 'admin']);
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isMember());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'waiting'
        && request.resource.data.keys().hasOnly(['email', 'name', 'photoURL', 'role', 'createdAt']);
      allow update: if isAdmin()
        && uid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role in ['waiting', 'member', 'admin', 'removed'];
      allow delete: if false;
    }

    match /submissions/{id} {
      allow read: if isMember();
      allow write: if false;
    }

    match /meta/{id} {
      allow read: if isMember();
      allow write: if false;
    }

    match /reviews/{id} {
      allow read: if isMember();
      allow write: if isAdmin()
        && request.resource.data.status in ['pending', 'maybe', 'approved', 'declined'];

      match /history/{h} {
        allow read: if isMember();
        allow create: if isAdmin();
        allow update, delete: if false;
      }
    }

    match /scores/{sid} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.uid == request.auth.uid
        && sid == request.resource.data.submissionId + '__' + request.auth.uid
        && request.resource.data.value is int
        && request.resource.data.value >= 1
        && request.resource.data.value <= 5;
      allow delete: if isMember() && resource.data.uid == request.auth.uid;
    }

    match /comments/{c} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 5000;
      allow update: if isMember()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 5000;
      allow delete: if isMember() && resource.data.uid == request.auth.uid;
    }
  }
}
