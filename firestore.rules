rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(roles) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().role in roles;
    }

    function isMember() {
      return hasRole(['member', 'admin']);
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isMember());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'waiting'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['email', 'name', 'photoURL', 'role', 'createdAt']);
      allow update: if isAdmin()
        && uid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role in ['waiting', 'member', 'admin', 'removed'];
      allow delete: if false;
    }

    match /submissions/{id} {
      allow read: if isMember();
      allow write: if false;
    }

    match /meta/{id} {
      allow read: if isMember();
      allow write: if false;
    }

    match /reviews/{id} {
      allow read: if isMember();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['status', 'updatedAt', 'updatedBy', 'updatedByName'])
        && request.resource.data.status in ['pending', 'maybe', 'approved', 'declined']
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByName == me().name
        && request.resource.data.updatedAt == request.time;

      match /history/{h} {
        allow read: if isMember();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['from', 'to', 'by', 'byName', 'at'])
          && request.resource.data.from in ['pending', 'maybe', 'approved', 'declined']
          && request.resource.data.to in ['pending', 'maybe', 'approved', 'declined']
          && request.resource.data.by == request.auth.uid
          && request.resource.data.byName == me().name
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }

    match /scores/{sid} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['submissionId', 'uid', 'name', 'value', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == me().name
        && request.resource.data.updatedAt == request.time
        && sid == request.resource.data.submissionId + '__' + request.auth.uid
        && request.resource.data.value is int
        && request.resource.data.value >= 1
        && request.resource.data.value <= 5;
      allow delete: if isMember() && resource.data.uid == request.auth.uid;
    }

    match /comments/{c} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['submissionId', 'uid', 'name', 'text', 'createdAt', 'editedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == me().name
        && request.resource.data.createdAt == request.time
        && request.resource.data.editedAt == null
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 5000;
      allow update: if isMember()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
        && request.resource.data.editedAt == request.time
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 5000;
      allow delete: if isMember() && resource.data.uid == request.auth.uid;
    }
  }
}
