rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(roles) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().role in roles;
    }

    function isMember() {
      return hasRole(['member', 'admin']);
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isMember());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'waiting'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['email', 'name', 'photoURL', 'role', 'createdAt']);
      allow update: if isAdmin()
        && uid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role in ['waiting', 'member', 'admin', 'removed'];
      allow delete: if false;
    }

    match /submissions/{id} {
      allow read: if isMember();
      allow write: if false;
    }

    match /meta/{id} {
      allow read: if isMember();
      allow write: if false;
    }

    // Event settings. Rules OR together: the wildcard above stays false for every
    // other meta doc; this adds an admin write for meta/event only.
    match /meta/event {
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['fields', 'signatureHtml', 'updatedAt', 'updatedBy', 'updatedByName'])
        && request.resource.data.fields is list
        && request.resource.data.fields.size() <= 50
        && (!('signatureHtml' in request.resource.data)
          || (request.resource.data.signatureHtml is string && request.resource.data.signatureHtml.size() <= 50000))
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByName == me().name
        && request.resource.data.updatedAt == request.time;
    }

    match /templates/{id} {
      allow read: if isMember();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'subject', 'body', 'html', 'attachments', 'rule', 'stageId', 'updatedAt', 'updatedBy', 'updatedByName'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 1
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 50000
        && (!('html' in request.resource.data) || request.resource.data.html == null
          || (request.resource.data.html is string && request.resource.data.html.size() <= 200000))
        && request.resource.data.attachments is list
        && request.resource.data.attachments.size() <= 10
        && request.resource.data.rule in ['acceptance', 'decline', 'approved', 'anyone']
        && (request.resource.data.stageId == null || request.resource.data.stageId is string)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByName == me().name
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Sent and received mail: written by functions only.
    match /emails/{id} {
      allow read: if isMember();
      allow write: if false;
    }

    match /threads/{id} {
      allow read: if isMember();
      allow write: if false;

      match /messages/{m} {
        allow read: if isMember();
        allow write: if false;
      }
    }

    // AI overviews and neighbours: written by functions only.
    match /ai/{id} {
      allow read: if isMember();
      allow write: if false;
    }

    // Embedding vectors: server-only, no client access at all.
    match /aiVectors/{id} {
      allow read, write: if false;
    }

    match /reviews/{id} {
      allow read: if isMember();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['status', 'updatedAt', 'updatedBy', 'updatedByName'])
        && request.resource.data.status in ['pending', 'maybe', 'approved', 'declined']
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByName == me().name
        && request.resource.data.updatedAt == request.time;

      match /history/{h} {
        allow read: if isMember();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['from', 'to', 'by', 'byName', 'at'])
          && request.resource.data.from in ['pending', 'maybe', 'approved', 'declined']
          && request.resource.data.to in ['pending', 'maybe', 'approved', 'declined']
          && request.resource.data.by == request.auth.uid
          && request.resource.data.byName == me().name
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }

    match /scores/{sid} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['submissionId', 'uid', 'name', 'value', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == me().name
        && request.resource.data.updatedAt == request.time
        && sid == request.resource.data.submissionId + '__' + request.auth.uid
        && request.resource.data.value is int
        && request.resource.data.value >= 1
        && request.resource.data.value <= 5;
      allow delete: if isMember() && resource.data.uid == request.auth.uid;
    }

    match /comments/{c} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['submissionId', 'uid', 'name', 'text', 'createdAt', 'editedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == me().name
        && request.resource.data.createdAt == request.time
        && request.resource.data.editedAt == null
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 5000;
      allow update: if isMember()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
        && request.resource.data.editedAt == request.time
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 5000;
      allow delete: if isMember() && resource.data.uid == request.auth.uid;
    }
  }
}
